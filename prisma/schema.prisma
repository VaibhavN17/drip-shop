// Drip Irrigation Shop Management System — database schema
// PostgreSQL (Neon), UUID PKs, created_at/updated_at on all business tables.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// ENUMS
// ==========================================================

enum Role {
  OWNER
  ADMIN
  STAFF
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

enum LandAreaUnit {
  ACRE
  HECTARE
  GUNTHA
}

// ==========================================================
// USERS & AUTH
// ==========================================================

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  quotationsCreated Quotation[] @relation("QuotationCreatedBy")
  invoicesCreated   Invoice[]   @relation("InvoiceCreatedBy")
  paymentsCreated   Payment[]   @relation("PaymentCreatedBy")
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  customersCreated  Customer[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================================
// CUSTOMERS / FARMERS
// ==========================================================

model Customer {
  id              String        @id @default(uuid())
  customerCode    String        @unique @map("customer_code")
  fullName        String        @map("full_name")
  mobile          String
  alternateMobile String?       @map("alternate_mobile")
  address         String?
  village         String?
  taluka          String?
  district        String?
  state           String        @default("Maharashtra")
  pincode         String?
  aadhaarLast4    String?       @map("aadhaar_last4") // NEVER store full Aadhaar
  farmerId        String?       @map("farmer_id")
  surveyNumber    String?       @map("survey_number")
  gatNumber       String?       @map("gat_number")
  landArea        Decimal?      @map("land_area") @db.Decimal(10, 2)
  landAreaUnit    LandAreaUnit? @map("land_area_unit")
  crop            String?
  bankName        String?       @map("bank_name")
  accountLast4    String?       @map("account_last4") // NEVER store full account number
  notes           String?
  createdById     String?       @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  createdBy   User?        @relation(fields: [createdById], references: [id])
  quotations  Quotation[]
  invoices    Invoice[]

  @@index([mobile])
  @@index([fullName])
  @@index([village])
  @@map("customers")
}

// ==========================================================
// PRODUCTS
// ==========================================================

model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  nameMarathi String? @map("name_marathi")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id              String   @id @default(uuid())
  productCode     String   @unique @map("product_code")
  name            String
  nameMarathi     String?  @map("name_marathi")
  categoryId      String?  @map("category_id")
  description     String?
  unit            String   @default("Nos")
  hsnCode         String?  @map("hsn_code")
  gstRate         Decimal  @default(18) @map("gst_rate") @db.Decimal(5, 2)
  purchaseRate    Decimal? @map("purchase_rate") @db.Decimal(12, 2)
  sellingRate     Decimal  @map("selling_rate") @db.Decimal(12, 2)
  governmentRate  Decimal? @map("government_rate") @db.Decimal(12, 2)
  stockQty        Decimal? @map("stock_qty") @db.Decimal(12, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  quotationItems  QuotationItem[]
  invoiceItems    InvoiceItem[]
  governmentRates GovernmentRate[]

  @@index([productCode])
  @@map("products")
}

// ==========================================================
// GOVERNMENT SCHEMES / RATES
// ==========================================================

model GovernmentScheme {
  id             String   @id @default(uuid())
  schemeName     String   @map("scheme_name")
  financialYear  String   @map("financial_year") // e.g. "2026-27"
  component      String?  // e.g. "Drip Irrigation - Micro Sprinkler"
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  rates      GovernmentRate[]
  quotations Quotation[]

  @@map("government_schemes")
}

model GovernmentRate {
  id                     String   @id @default(uuid())
  schemeId               String   @map("scheme_id")
  productId              String?  @map("product_id")
  unit                   String
  governmentRate         Decimal  @map("government_rate") @db.Decimal(12, 2)
  maximumEligibleQuantity Decimal? @map("maximum_eligible_quantity") @db.Decimal(12, 2)
  subsidyPercentage      Decimal  @map("subsidy_percentage") @db.Decimal(5, 2)
  effectiveFrom          DateTime @map("effective_from")
  effectiveTo            DateTime? @map("effective_to")
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  scheme  GovernmentScheme @relation(fields: [schemeId], references: [id])
  product Product?         @relation(fields: [productId], references: [id])

  @@map("government_rates")
}

// ==========================================================
// QUOTATIONS
// ==========================================================

model Quotation {
  id                 String          @id @default(uuid())
  quotationNumber    String          @unique @map("quotation_number")
  customerId         String          @map("customer_id")
  quotationDate      DateTime        @default(now()) @map("quotation_date")
  validUntil         DateTime?       @map("valid_until")
  schemeId           String?         @map("scheme_id")
  subsidyPercentage  Decimal?        @map("subsidy_percentage") @db.Decimal(5, 2)
  isSubsidyBased     Boolean         @default(false) @map("is_subsidy_based")
  landArea           Decimal?        @map("land_area") @db.Decimal(10, 2)
  status             QuotationStatus @default(DRAFT)
  subtotal           Decimal         @default(0) @db.Decimal(14, 2)
  fileExpense        Decimal         @default(0) @map("file_expense") @db.Decimal(12, 2)
  otherCharges       Decimal         @default(0) @map("other_charges") @db.Decimal(12, 2)
  gstRate            Decimal         @default(18) @map("gst_rate") @db.Decimal(5, 2)
  gstAmount          Decimal         @default(0) @map("gst_amount") @db.Decimal(14, 2)
  totalAmount        Decimal         @default(0) @map("total_amount") @db.Decimal(14, 2)
  eligibleAmount     Decimal?        @map("eligible_amount") @db.Decimal(14, 2)
  subsidyAmount      Decimal?        @map("subsidy_amount") @db.Decimal(14, 2)
  farmerContribution Decimal?        @map("farmer_contribution") @db.Decimal(14, 2)
  nonEligibleAmount  Decimal?        @map("non_eligible_amount") @db.Decimal(14, 2)
  notes              String?
  createdById        String?         @map("created_by_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  customer  Customer          @relation(fields: [customerId], references: [id])
  scheme    GovernmentScheme? @relation(fields: [schemeId], references: [id])
  createdBy User?             @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  items     QuotationItem[]
  invoice   Invoice?

  @@index([quotationNumber])
  @@map("quotations")
}

model QuotationItem {
  id             String   @id @default(uuid())
  quotationId    String   @map("quotation_id")
  productId      String?  @map("product_id")
  description    String
  quantity       Decimal  @db.Decimal(12, 3)
  unit           String
  governmentRate Decimal? @map("government_rate") @db.Decimal(12, 2)
  sellingRate    Decimal  @map("selling_rate") @db.Decimal(12, 2)
  gstRate        Decimal  @default(18) @map("gst_rate") @db.Decimal(5, 2)
  amount         Decimal  @db.Decimal(14, 2)
  sortOrder      Int      @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

// ==========================================================
// INVOICES
// ==========================================================

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  customerId    String        @map("customer_id")
  quotationId   String?       @unique @map("quotation_id")
  invoiceDate   DateTime      @default(now()) @map("invoice_date")
  subtotal      Decimal       @default(0) @db.Decimal(14, 2)
  cgst          Decimal       @default(0) @db.Decimal(14, 2)
  sgst          Decimal       @default(0) @db.Decimal(14, 2)
  igst          Decimal       @default(0) @db.Decimal(14, 2)
  gstRate       Decimal       @default(18) @map("gst_rate") @db.Decimal(5, 2)
  gstAmount     Decimal       @default(0) @map("gst_amount") @db.Decimal(14, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  roundOff      Decimal       @default(0) @map("round_off") @db.Decimal(6, 2)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(14, 2)
  balanceAmount Decimal       @default(0) @map("balance_amount") @db.Decimal(14, 2)
  paymentStatus PaymentStatus @default(UNPAID) @map("payment_status")
  isInterstate  Boolean       @default(false) @map("is_interstate")
  notes         String?
  createdById   String?       @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  customer  Customer       @relation(fields: [customerId], references: [id])
  quotation Quotation?     @relation(fields: [quotationId], references: [id])
  createdBy User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  items     InvoiceItem[]
  payments  Payment[]

  @@index([invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  productId     String?  @map("product_id")
  description   String
  hsnCode       String?  @map("hsn_code")
  quantity      Decimal  @db.Decimal(12, 3)
  unit          String
  rate          Decimal  @db.Decimal(12, 2)
  taxableValue  Decimal  @map("taxable_value") @db.Decimal(14, 2)
  gstRate       Decimal  @default(18) @map("gst_rate") @db.Decimal(5, 2)
  cgstAmount    Decimal  @default(0) @map("cgst_amount") @db.Decimal(12, 2)
  sgstAmount    Decimal  @default(0) @map("sgst_amount") @db.Decimal(12, 2)
  igstAmount    Decimal  @default(0) @map("igst_amount") @db.Decimal(12, 2)
  totalAmount   Decimal  @map("total_amount") @db.Decimal(14, 2)
  sortOrder     Int      @default(0) @map("sort_order")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

// ==========================================================
// PAYMENTS
// ==========================================================

model Payment {
  id              String        @id @default(uuid())
  invoiceId       String        @map("invoice_id")
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime      @default(now()) @map("payment_date")
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number")
  notes           String?
  createdById     String?       @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  createdBy User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

// ==========================================================
// SETTINGS & AUDIT
// ==========================================================

model ShopSettings {
  id                  String   @id @default(uuid())
  shopName            String   @map("shop_name")
  address             String?
  mobile              String?
  email                String?
  gstin               String?
  state               String   @default("Maharashtra")
  district            String?
  logoUrl             String?  @map("logo_url")
  upiId               String?  @map("upi_id")
  bankName            String?  @map("bank_name")
  bankAccountNumber   String?  @map("bank_account_number")
  bankIfsc            String?  @map("bank_ifsc")
  invoicePrefix       String   @default("INV") @map("invoice_prefix")
  quotationPrefix     String   @default("QTN") @map("quotation_prefix")
  defaultGstRate      Decimal  @default(18) @map("default_gst_rate") @db.Decimal(5, 2)
  defaultSubsidyPct   Decimal? @map("default_subsidy_pct") @db.Decimal(5, 2)
  footerText          String?  @map("footer_text")
  termsAndConditions  String?  @map("terms_and_conditions")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
